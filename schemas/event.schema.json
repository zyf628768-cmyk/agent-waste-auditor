{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentwaste.invalid/schemas/event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "model",
        "tool",
        "human",
        "wait",
        "task"
      ]
    },
    "status": {
      "enum": [
        "success",
        "failed",
        "timeout",
        "unknown",
        "running"
      ]
    },
    "category": {
      "enum": [
        "model",
        "tool",
        "human",
        "failure",
        "rework",
        "wait",
        "quality"
      ]
    },
    "origin": {
      "enum": [
        "actual",
        "estimated",
        "manual"
      ]
    },
    "amount": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
      "format": "money"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "retry_reason": {
      "enum": [
        "unknown",
        "transient",
        "user_requested",
        "idempotent_check"
      ]
    },
    "input_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "output_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cached_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "cache_write_tokens": {
      "type": "integer",
      "minimum": 0
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0
    },
    "queue_ms": {
      "type": "integer",
      "minimum": 0
    },
    "human_wait_ms": {
      "type": "integer",
      "minimum": 0
    },
    "source_line": {
      "type": "integer",
      "minimum": 0
    },
    "synthetic": {
      "type": "boolean"
    },
    "progress": {
      "type": "boolean"
    },
    "usage_complete": {
      "type": "boolean"
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "context_signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "id",
    "task_id",
    "agent",
    "timestamp",
    "kind"
  ],
  "dependentRequired": {
    "amount": [
      "currency",
      "origin"
    ]
  }
}
