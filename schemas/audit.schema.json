{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentwaste.invalid/schemas/audit.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_type",
    "synthetic",
    "totals",
    "tasks",
    "charges",
    "findings",
    "coverage",
    "timeline",
    "trend",
    "high_cost_steps",
    "successful_tasks",
    "average_cost_per_success",
    "average_cost_definition"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_type": {
      "const": "audit"
    },
    "synthetic": {
      "type": "boolean"
    },
    "totals": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z]{3}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "actual",
          "estimated",
          "manual"
        ],
        "additionalProperties": false,
        "properties": {
          "actual": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
          },
          "estimated": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
          },
          "manual": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "task_id",
          "agent",
          "status",
          "totals",
          "unknown_costs",
          "roi",
          "cost_coverage"
        ],
        "properties": {
          "task_id": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "status": {
            "enum": [
              "success",
              "failed",
              "running",
              "unknown"
            ]
          },
          "totals": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "actual",
                "estimated",
                "manual"
              ],
              "additionalProperties": false,
              "properties": {
                "actual": {
                  "type": "string",
                  "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
                },
                "estimated": {
                  "type": "string",
                  "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
                },
                "manual": {
                  "type": "string",
                  "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
                }
              }
            }
          },
          "unknown_costs": {
            "type": "array"
          },
          "cost_coverage": {
            "type": "object",
            "required": [
              "known_events",
              "cost_bearing_events",
              "complete"
            ],
            "properties": {
              "complete": {
                "type": "boolean"
              },
              "known_events": {
                "type": "integer",
                "minimum": 0
              },
              "cost_bearing_events": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "roi": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "unavailable",
                  "scenario_estimate",
                  "verified_basis"
                ]
              }
            }
          }
        }
      }
    },
    "charges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "task_id",
          "category",
          "amount",
          "origin",
          "currency"
        ],
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "origin": {
            "enum": [
              "actual",
              "estimated",
              "manual"
            ]
          },
          "source": {
            "enum": [
              "event",
              "task_metadata"
            ]
          },
          "category": {
            "enum": [
              "model",
              "tool",
              "human",
              "failure",
              "rework",
              "wait",
              "quality"
            ]
          },
          "event_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "price_id": {
            "type": "string"
          },
          "failed": {
            "type": "boolean"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "task_id",
          "conclusion",
          "explanation",
          "recommendation",
          "evidence"
        ],
        "properties": {
          "conclusion": {
            "const": "suspected_inefficiency"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "event_id",
                "source_line",
                "status",
                "signature"
              ],
              "properties": {
                "event_id": {
                  "type": "string"
                },
                "source_line": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "status": {
                  "type": "string"
                },
                "signature": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "events",
        "tasks",
        "unknown_cost_items",
        "warnings",
        "scope"
      ]
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "task_id",
          "timestamp",
          "kind"
        ]
      }
    },
    "trend": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date_utc",
          "totals"
        ],
        "properties": {
          "totals": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "additionalProperties": {
              "type": "object",
              "required": [
                "actual",
                "estimated",
                "manual"
              ],
              "additionalProperties": false,
              "properties": {
                "actual": {
                  "type": "string",
                  "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
                },
                "estimated": {
                  "type": "string",
                  "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
                },
                "manual": {
                  "type": "string",
                  "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
                }
              }
            }
          }
        }
      }
    },
    "high_cost_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event_id",
          "task_id",
          "category",
          "amount",
          "origin",
          "currency"
        ],
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "origin": {
            "enum": [
              "actual",
              "estimated",
              "manual"
            ]
          },
          "source": {
            "enum": [
              "event",
              "task_metadata"
            ]
          },
          "category": {
            "enum": [
              "model",
              "tool",
              "human",
              "failure",
              "rework",
              "wait",
              "quality"
            ]
          },
          "event_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "price_id": {
            "type": "string"
          },
          "failed": {
            "type": "boolean"
          }
        }
      }
    },
    "successful_tasks": {
      "type": "integer",
      "minimum": 0
    },
    "average_cost_per_success": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$"
      }
    },
    "average_cost_definition": {
      "type": "string"
    }
  }
}
