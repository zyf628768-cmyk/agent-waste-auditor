{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentwaste.invalid/schemas/comparison.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "report_type": {
      "const": "comparison"
    },
    "synthetic": {
      "type": "boolean"
    },
    "dimension": {
      "enum": [
        "agent",
        "model",
        "prompt_strategy",
        "workflow"
      ]
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "difficulty": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "acceptance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "cost_coverage_complete": {
            "type": "boolean"
          },
          "coverage_signature": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "human_effort_known": {
                "type": "boolean"
              },
              "monetary_basis": {
                "type": "array",
                "items": {
                  "enum": [
                    "actual",
                    "estimated",
                    "manual"
                  ]
                }
              },
              "unknown_reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "currencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                }
              }
            },
            "required": [
              "human_effort_known",
              "monetary_basis",
              "unknown_reasons",
              "currencies"
            ]
          },
          "comparable": {
            "type": "boolean"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "agent": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "dimension": {
                  "enum": [
                    "agent",
                    "model",
                    "prompt_strategy",
                    "workflow"
                  ]
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 0
                },
                "known_outcomes": {
                  "type": "integer",
                  "minimum": 0
                },
                "successes": {
                  "type": "integer",
                  "minimum": 0
                },
                "unknown_outcomes": {
                  "type": "integer",
                  "minimum": 0
                },
                "rework_events": {
                  "type": "integer",
                  "minimum": 0
                },
                "success_rate": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                      "format": "money"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "totals": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "actual": {
                        "type": "string",
                        "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                        "format": "money"
                      },
                      "estimated": {
                        "type": "string",
                        "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                        "format": "money"
                      },
                      "manual": {
                        "type": "string",
                        "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                        "format": "money"
                      }
                    },
                    "required": [
                      "actual",
                      "estimated",
                      "manual"
                    ]
                  }
                },
                "cost_per_attempt": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "actual": {
                        "type": "string",
                        "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                        "format": "money"
                      },
                      "estimated": {
                        "type": "string",
                        "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                        "format": "money"
                      },
                      "manual": {
                        "type": "string",
                        "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                        "format": "money"
                      }
                    },
                    "required": [
                      "actual",
                      "estimated",
                      "manual"
                    ]
                  }
                },
                "cost_per_success": {
                  "anyOf": [
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "actual": {
                            "type": "string",
                            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                            "format": "money"
                          },
                          "estimated": {
                            "type": "string",
                            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                            "format": "money"
                          },
                          "manual": {
                            "type": "string",
                            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                            "format": "money"
                          }
                        },
                        "required": [
                          "actual",
                          "estimated",
                          "manual"
                        ]
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "human_minutes": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                      "format": "money"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "elapsed_median_seconds": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                      "format": "money"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "elapsed_seconds": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                        "format": "money"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "required": [
                "agent",
                "dimension",
                "attempts",
                "known_outcomes",
                "successes",
                "unknown_outcomes",
                "rework_events",
                "success_rate",
                "totals",
                "cost_per_attempt",
                "cost_per_success",
                "human_minutes",
                "elapsed_median_seconds",
                "elapsed_seconds"
              ]
            }
          }
        },
        "required": [
          "task_key",
          "difficulty",
          "acceptance_id",
          "cost_coverage_complete",
          "coverage_signature",
          "comparable",
          "agents"
        ]
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "reason"
        ]
      }
    },
    "caution": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "report_type",
    "synthetic",
    "dimension",
    "groups",
    "excluded",
    "caution"
  ]
}
