{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentwaste.invalid/schemas/pricing.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "prices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "effective_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "effective_to": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "input_per_million": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "format": "money"
          },
          "output_per_million": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "format": "money"
          },
          "cache_read_per_million": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "format": "money"
          },
          "cache_write_per_million": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "format": "money"
          }
        },
        "required": [
          "id",
          "model",
          "currency",
          "source",
          "effective_from",
          "effective_to",
          "input_per_million",
          "output_per_million"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "prices"
  ]
}
